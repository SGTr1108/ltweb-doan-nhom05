Options -Indexes

RewriteEngine On

# Chặn tệp và thư mục ẩn, trừ .well-known.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [R=404,L]

# Chặn truy cập trực tiếp vào tệp cấu hình và dữ liệu nhạy cảm.
RewriteRule \.(sql|log|bak|ini|lock)$ - [F,L,NC]
RewriteRule ^composer\.json$ - [F,L,NC]

# Chặn truy cập vào các thư mục nội bộ.
RewriteRule ^(inc|src|vendor|database|logs|storage)(/|$) - [R=404,L]

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
