X-CSRF-Token: {{csrfNv}}
Content-Type: application/json

{"id": {{sanPhamId}}, "so_luong": 1}

### 13 - Xem tổng giỏ trước thử
# Tổng phải lớn hơn 10000. Ghi số đơn, chi tiết đơn và tồn kho trước thử.
GET {{base}}/api/gio-hang.php
Cookie: PHPSESSID={{sidNv}}

### 13 - Gửi thiếu tiền trực tiếp đến máy chủ
# Mong đợi thông báo thiếu tiền, số đơn/chi tiết/tồn kho/giỏ giữ nguyên.
# SQL trước và sau: SELECT COUNT(*) FROM don_hang; SELECT COUNT(*) FROM chi_tiet_don;
# SELECT id, ton_kho FROM san_pham WHERE id = <ID đã chọn>;
POST {{base}}/dat-hang.php
Cookie: PHPSESSID={{sidNv}}
Content-Type: application/x-www-form-urlencoded

csrf={{csrfNv}}&ten_khach=Khach+thu+ca13&sdt_khach=&tien_khach_dua=10000&ghi_chu=Thu+thieu+tien

### 13 - Xem lại giỏ sau thử
GET {{base}}/api/gio-hang.php
Cookie: PHPSESSID={{sidNv}}

### 14 - Tải TXT giả ảnh (dữ liệu multipart nhúng sẵn)
# Chọn danhMucId có tồn tại, các trường còn lại hợp lệ.
# Mong đợi thông báo chỉ nhận JPG/PNG/WebP, không tạo sản phẩm và không lưu ảnh.
# SQL: SELECT id, ten, anh FROM san_pham WHERE ten = 'San pham thu ca 14';
POST {{base}}/them-san-pham.php
Cookie: PHPSESSID={{sidAdmin}}
Content-Type: multipart/form-data; boundary=MiniPosCa14Boundary

--MiniPosCa14Boundary
Content-Disposition: form-data; name="csrf"

{{csrfAdmin}}
--MiniPosCa14Boundary
Content-Disposition: form-data; name="ten"

San pham thu ca 14
--MiniPosCa14Boundary
Content-Disposition: form-data; name="danh_muc_id"

{{danhMucId}}
--MiniPosCa14Boundary
Content-Disposition: form-data; name="gia"

15000
--MiniPosCa14Boundary
Content-Disposition: form-data; name="ton_kho"

1
--MiniPosCa14Boundary
Content-Disposition: form-data; name="mo_ta"

Thu tep TXT
--MiniPosCa14Boundary
Content-Disposition: form-data; name="anh"; filename="ca14-test.txt"
Content-Type: text/plain

Tep van ban vo hai dung cho ca 14.
--MiniPosCa14Boundary--

# Tùy chọn ca 14: gửi ảnh JPG/PNG/WebP thật lớn hơn 2MB bằng form trình duyệt.
# Ghi thông báo thực tế, kiểm tra sản phẩm và images/ trước/sau.
# Khôi phục cấu hình thử. Bỏ cookie, CSRF và mật khẩu thật khỏi biến trước khi commit.
