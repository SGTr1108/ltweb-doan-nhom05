### 11 - Kiểm tra thủ công trong MariaDB và trình duyệt
# Đổi .env sang nhom05_app rồi thao tác lại chức năng Bài tập 6.
# mysql -h localhost -P 3306 -u nhom05_app -p ltweb_nhom05
# SELECT CURRENT_USER(), DATABASE();
# SHOW GRANTS;
# Root tạo riêng bảng thử: CREATE TABLE ltweb_nhom05.ca11_bang_thu (id INT PRIMARY KEY);
# Với nhom05_app:
# CREATE TABLE ca11_tao_thu (id INT PRIMARY KEY);
# DROP TABLE ca11_bang_thu;
# SHOW TABLES LIKE 'ca11_bang_thu';
# Mong đợi 1142 cho CREATE/DROP, bảng thử vẫn tồn tại. Root dọn bảng thử sau ca.


