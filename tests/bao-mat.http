# Kiểm tra bản ghi sai bị xóa và log dang_nhap_sai không chứa mật khẩu.
POST {{base}}/dang-nhap.php
Cookie: PHPSESSID={{sid}}
Content-Type: application/x-www-form-urlencoded

csrf={{csrf}}&email={{emailThu}}&mat_khau={{matKhauThu}}

